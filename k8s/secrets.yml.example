---
# Kubernetes Secrets for sensitive data
# IMPORTANT: This is an example file. Copy this to secrets.yml and replace with actual base64-encoded values.
# DO NOT commit secrets.yml to version control!
#
# To base64 encode a value:
#   Linux/Mac: echo -n "your-value" | base64
#   Windows PowerShell: [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("your-value"))
#
apiVersion: v1
kind: Secret
metadata:
  name: recipe-planner-secrets
  labels:
    app: recipe-planner
type: Opaque
data:
  # Database credentials (base64 encoded)
  database-name: cmVjaXBlX3BsYW5uZXJfcHJvZHVjdGlvbg==  # recipe_planner_production
  database-user: cG9zdGdyZXM=                        # postgres
  database-password: Y2hhbmdlLW1lLXRvLXNlY3VyZS1wYXNzd29yZA==  # change-me-to-secure-password

  # Rails master key (base64 encoded - get from config/master.key)
  rails-master-key: Y2hhbmdlLW1lLXRvLXlvdXItYWN0dWFsLW1hc3Rlci1rZXk=  # change-me-to-your-actual-master-key

  # Secret key base (base64 encoded - generate with: rails secret)
  secret-key-base: Y2hhbmdlLW1lLXRvLWdlbmVyYXRlZC1zZWNyZXQta2V5LWJhc2U=  # change-me-to-generated-secret-key-base
